<Window x:Class="WalletScan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WalletScan"
        Height="660" Width="980" MinHeight="500" MinWidth="760"
        Background="#FFFFFF" Foreground="#1F2937"
        FontFamily="Segoe UI" FontSize="12.5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="Line" Color="#E3E7ED"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
        <SolidColorBrush x:Key="Navy" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="NavyHover" Color="#25486F"/>
        <SolidColorBrush x:Key="Panel" Color="#F9FAFB"/>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Navy}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar strip -->
        <Border Grid.Row="0" Background="{StaticResource Navy}" Padding="24,14">
            <StackPanel>
                <TextBlock Text="WalletScan" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Foreground="#A9BCD3" FontSize="11.5" Margin="0,2,0,0"
                           Text="Local wallet software inventory"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="ScanButton" Content="Scan this PC"
                        Style="{StaticResource Primary}" Click="ScanButton_Click"/>
                <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource Secondary}" Margin="8,0,0,0"
                        Click="CancelButton_Click" IsEnabled="False"/>
                <Button Grid.Column="2" x:Name="ExportButton" Content="Export CSV"
                        Style="{StaticResource Secondary}" Margin="8,0,0,0"
                        Click="ExportButton_Click" IsEnabled="False"/>

                <TextBlock Grid.Column="4" x:Name="StatusText" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Text="Ready."/>
            </Grid>
        </Border>

        <!-- Results panel -->
        <Grid Grid.Row="2" Margin="24,18,24,0">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <ListView x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              FontSize="12.5">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Wallet" Width="200" DisplayMemberBinding="{Binding WalletName}"/>
                                <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="Location" Width="290" DisplayMemberBinding="{Binding Location}"/>
                                <GridViewColumn Header="Installed (UTC)" Width="150" DisplayMemberBinding="{Binding InstalledText}"/>
                                <GridViewColumn Header="Version" Width="90" DisplayMemberBinding="{Binding Version}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="No results yet" Foreground="#374151" FontSize="13"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Select Scan this PC to begin." Foreground="{StaticResource Muted}"
                                   FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="24,14,24,18">
            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                       Text="Read-only scan. Registry, filesystem and browser profile metadata only. No admin rights needed. Nothing leaves this machine."/>
        </Border>
    </Grid>
</Window>
